{
  "manifest_version": 3,
  "name": "GitHub for Jason",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["pulls.js"],
      "run_at": "document_start"
    }
  ]
}
