{
  "manifest_version": 3,
  "name": "GitHub for Jason",
  "version": "0.1.0",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["pulls.js"],
      "css": ["pulls.css"],
      "run_at": "document_start"
    }
  ]
}
